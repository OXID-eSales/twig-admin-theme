{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate, box: "box"} %}

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="cl" value="theme_main">
    <input type="hidden" name="editlanguage" value="{{ editlanguage }}">
</form>

{% if theme %}
{% block admin_theme_main_form %}
<table cellspacing="10" width="98%">
    <tr>
        <td width="20%" valign="top"><img src="{{ oViewConf.getBaseDir()|raw }}/out/{{ theme.getId() }}/{{ theme.getThumbnail() }}" hspace="20" vspace="10"></td>
        <td width="50%" valign="top">
            <h1 style="color:#000;font-size:25px;">{{ theme.getTitle() }}</h1>
            <p>{{ theme.getDescription() }}</p>
            {% if parentTheme %}
                <strong>{{ translate({ ident: "THEME_PARENT_THEME_TITLE" }) }}: </strong>
                {% if theme.getActivationError() %}
                    <span class="error">{{ parentTheme.getId() }}</span>
                {% else %}
                    <a class="themetitle" href="{{ oViewConf.getSelfLink()|raw }}&amp;cl=theme_main&amp;oxid={{ parentTheme.getId() }}&amp;updatelist=1">{{ parentTheme.getTitle()|default(parentTheme.getId()) }}</a>
                {% endif %}
                <br>
                <strong>{{ translate({ ident: "THEME_PARENT_VERSIONS" }) }}: </strong> {{ parentTheme.getVersions()|join(', ') }}
            {% endif %}
            <hr>
            <p style="color:#aaa;">
            <b>{{ translate({ ident: "THEME_AUTHOR" }) }}</b> {{ theme.getAuthor()|default(' - ')|raw() }} <br><br>
            {{ translate({ ident: "THEME_VERSION" }) }} {{ theme.getVersion() }}
            </p>
        </td>
        {% if not theme.isActive() %}
            <td width="1%">
                <img src="{{ oViewConf.getImageUrl()|raw }}/grayline_vert.gif" width="2" height="270" alt="" border="0">
            </td>
            <td width="19%" valign="top">
                {% if not theme.getActivationError() %}
                    <form name="myedit" id="myedit" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
                        <p>
                        {{ oViewConf.getHiddenSid()|raw }}
                        <input type="hidden" name="cl" value="theme_main">
                        <input type="hidden" name="fnc" value="setTheme">
                        <input type="hidden" name="updatelist" value="1">
                        <input type="hidden" name="oxid" value="{{ theme.getId() }}">
                        <input type="submit" value="{{ translate({ ident: "THEME_ACTIVATE" }) }}">
                        </p>
                    </form>
                {% else %}
                    <div class="error">{{ translate({ ident: theme.getActivationError() }) }}</div>
                {% endif %}
            </td>
        {% endif %}
    </tr>
</table>
{% endblock %}
{% endif %}

{% include "bottomnaviitem.html.twig" %}
{% include "bottomitem.html.twig" %}
