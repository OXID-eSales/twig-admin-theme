{% include "headitem.html.twig" with {title: "GENERAL_ADMIN_TITLE"|translate, box: "box"} %}

<script>
<!--
function _groupExp(el) {
    var _cur = el.parentNode;

    if (_cur.className == "exp") _cur.className = "";
      else _cur.className = "exp";
}
//-->
</script>

{% if readonly %}
    {% set readonly = "readonly disabled" %}
{% else %}
    {% set readonly = "" %}
{% endif %}



<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ themeId }}">
    <input type="hidden" name="cl" value="theme_config">
    <input type="hidden" name="fnc" value="">
    <input type="hidden" name="actshop" value="{{ oViewConf.getActiveShopId() }}">
    <input type="hidden" name="updatenav" value="">
    <input type="hidden" name="editlanguage" value="{{ editlanguage }}">
</form>

<form name="myedit" id="myedit" action="{{ oViewConf.getSelfLink()|raw }}" method="post">
{{ oViewConf.getHiddenSid()|raw }}
<input type="hidden" name="cl" value="theme_config">
<input type="hidden" name="fnc" value="save">
<input type="hidden" name="oxid" value="{{ themeId }}">

    <b>{{ themeTitle }}</b><br><br>

    {% for groupName, settings in settingGroups %}
        <div class="groupExp">
            <div>
            {% block admin_theme_config_form %}
                <a href="#" onclick="_groupExp(this);return false;" class="rc"><b>{{ translate({ ident: "SHOP_THEME_GROUP_" ~ groupName }) }}</b></a>
                {% for setting in settings %}
                    {% if setting.isEnvironmentOverridden %}
                        {% set inputState = "disabled" %}
                    {% else %}
                        {% set inputState = readonly %}
                    {% endif %}
                    <dl>
                        <dt>
                            {% if setting.type == 'bool' %}
                                {% if not setting.isEnvironmentOverridden %}
                                    <input type="hidden" name="settings[{{ setting.name }}]" value="false">
                                {% endif %}
                                <input type="checkbox" name="settings[{{ setting.name }}]" value="true" {% if setting.value %}checked{% endif %} {{ inputState }}>
                            {% elseif setting.type == 'str' %}
                                <input type="text" class="txt" style="width: 250px;" name="settings[{{ setting.name }}]" value="{{ setting.value }}" {{ inputState }}>
                            {% elseif setting.type == 'num' %}
                                <input type="text" class="txt" style="width: 50px;" name="settings[{{ setting.name }}]" value="{{ setting.value }}" {{ inputState }}>
                            {% elseif setting.type == 'arr' %}
                                <textarea class="txtfield" name="settings[{{ setting.name }}]" {{ inputState }}>{{ setting.value }}</textarea>
                            {% elseif setting.type == 'aarr' %}
                                <textarea class="txtfield" style="width: 430px;" name="settings[{{ setting.name }}]" wrap="off" {{ inputState }}>{{ setting.value }}</textarea>
                            {% elseif setting.type == 'select' %}
                                <select class="select" name="settings[{{ setting.name }}]" {{ inputState }}>
                                    {% for option in setting.options %}
                                        <option value="{{ option }}" {% if setting.value == option %}selected{% endif %}>{{ translate({ ident: "SHOP_THEME_" ~ setting.name ~ "_" ~ option }) }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                            {% include "inputhelp.html.twig" with {'sHelpId': help_id("HELP_SHOP_THEME_" ~ setting.name), 'sHelpText': help_text("HELP_SHOP_THEME_" ~ setting.name)} %}
                        </dt>
                        <dd>
                            {{ translate({ ident: "SHOP_THEME_" ~ setting.name }) }}
                            {% if setting.isEnvironmentOverridden %}
                                <br><em>{{ translate({ ident: "THEME_SETTING_ENVIRONMENT_OVERRIDDEN_HINT" }) }}</em>
                            {% endif %}
                        </dd>
                        <div class="spacer"></div>
                    </dl>
                {% endfor %}
             {% endblock %}
             </div>
         </div>
    {% endfor %}
<br>
<input type="submit" class="confinput" name="save" value="{{ translate({ ident: "GENERAL_SAVE" }) }}" onClick="Javascript:document.myedit.fnc.value='save'" {{ readonly }}>
</form>
{% include "bottomnaviitem.html.twig" %}
{% include "bottomitem.html.twig" %}
